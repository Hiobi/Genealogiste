# Copier dans <répertoire de données>/.env (par défaut ~/.local/share/genealogiste/.env) — jamais dans un dépôt.

# Répertoire de données (dépôt Git de l'arbre) et cache
#GENEALOGISTE_DATA_DIR=~/genealogie
#GENEALOGISTE_CACHE=~/.cache/genealogiste/cache.sqlite
# Markdown extrait des PDF (pdf_markdown) ; défaut <données>/cache-pdf
#GENEALOGISTE_CACHE_PDF_DIR=
# Binaire Tesseract (OCR des PDF scannés) hors du PATH, ou shim Docker ; défaut « tesseract »
#GENEALOGISTE_TESSERACT=

# WikiTree : identifiant d'application (libre, ex. « genealogiste-<pseudo> »), obligatoire
GENEALOGISTE_WIKITREE_APPID=

# matchID : jeton pour l'appariement CSV par lot (facultatif)
GENEALOGISTE_MATCHID_TOKEN=

# Backend : fichier (défaut, arbre.ged GEDCOM 7 + Git) | gramps (Gramps Web = arbre de référence, voir docs/gramps-web.md)
GENEALOGISTE_BACKEND=fichier
# Garde-fou d'écriture côté serveur : autorisee (défaut) | interdite. interdite = le serveur refuse tout outil
# d'écriture (arbre_appliquer, pieces_appliquer, Gramps Web, notes, fichiers de l'utilisateur), quel que soit le
# mode de permission du client. À fixer pour toute session sans surveillance (docs/campagne.md).
GENEALOGISTE_ECRITURE=autorisee
# Gramps Web : compte LOCAL dédié à Genealogiste, rôle Editor
GENEALOGISTE_GRAMPS_URL=http://localhost:5055
GENEALOGISTE_GRAMPS_USER=
GENEALOGISTE_GRAMPS_PASSWORD=
# Mode gramps : liens internes gramps:// dans les notes de preuve Genealogiste:auto (false par défaut). Changer la
# valeur ne réécrit rien : gramps_recalculer_notes propose le passage (diff, accord, annulable). docs/gramps-web.md
GENEALOGISTE_GRAMPS_NOTES_LIENS=false
# Mode gramps : tâches de Gramps Web (source + note étiquetées ToDo) lues et écrites comme tâches (false par
# défaut : rien ne change). Jamais automatique : chaque tâche passe par une proposition. docs/gramps-web.md
GENEALOGISTE_GRAMPS_TACHES=false
# Mode gramps : miroir GEDCOM 7 versionné de l'arbre Gramps dans le dépôt des données
GENEALOGISTE_GIT_MIRROR=false
# Dépôt distant du répertoire de données (facultatif, PRIVÉ : données de vivants)
GENEALOGISTE_GIT_REMOTE=
# Délai maximal d'une commande git, push vers le dépôt distant compris (secondes ; jamais d'invite)
GENEALOGISTE_GIT_DELAI=60
# Attente maximale de la régénération des notes dans arbre_appliquer (s) ; au-delà, elle continue en arrière-plan
GENEALOGISTE_NOTES_ATTENTE=20
# Kit Obsidian (vues Bases/Dataview, modèles, extrait CSS) déposé par notes_generer « tout »
GENEALOGISTE_NOTES_KIT=true
# Forme écrite des marqueurs (notes <!-- genealogiste:debut … -->, attributs Gramps Genealogiste-*) : genealogiste
# (défaut) | sosa (ancienne forme, pour partager notes ou base Gramps avec une ancienne version). Les deux sont lues.
GENEALOGISTE_MARQUEURS=genealogiste

# 1 = règle stricte 3/2/1 sources indépendantes sans pondération
GENEALOGISTE_STRICT=0
# 0 = autoriser un fait sans citation (déconseillé) ; défaut 1 : refus sauf non_source + motif
GENEALOGISTE_EXIGER_SOURCE=1
# 1 = n'utiliser que le cache
GENEALOGISTE_OFFLINE=0

# Débit : secondes minimum entre deux requêtes vers un même hôte (archives, IIIF… : jamais en rafale)
GENEALOGISTE_DEBIT_DEFAUT=1.5
# Surcharges par hôte, prioritaires sur le référentiel (intervalle_requetes) et le défaut
# GENEALOGISTE_DEBITS=archives.lenord.fr=3,gallica.bnf.fr=2
GENEALOGISTE_DEBITS=
# Reprises : délai d'un essai (s), essais au plus, plafond d'un appel d'outil attentes comprises (s)
GENEALOGISTE_HTTP_TIMEOUT=30
GENEALOGISTE_HTTP_TENTATIVES=5
GENEALOGISTE_HTTP_DUREE_MAX=60
# Plafond journalier de requêtes par hôte d'un service d'archives du référentiel (persistant, 0 = aucun)
GENEALOGISTE_PLAFOND_JOUR_ARCHIVES=1000
# Plafond journalier de requêtes vers tout autre hôte (API matchID, WikiTree, Gallica, Wikidata, Géo, IIIF…)
GENEALOGISTE_PLAFOND_JOUR_DEFAUT=1000
# Surcharges par hôte, prioritaires sur les deux plafonds ci-dessus (docs/securite.md, politique d'accès)
# GENEALOGISTE_PLAFONDS_JOUR=geo.api.gouv.fr=5000,gallica.bnf.fr=300
GENEALOGISTE_PLAFONDS_JOUR=
# Budget par défaut d'une enquête (docs/enquetes.md ; 0 = illimité), réglable à enquete_ouvrir/enquete_noter :
# requêtes émises par hôte, images lues. Il arrête une boucle d'enquête ; le coût réel se plafonne côté client
# (claude -p … --max-budget-usd). GENEALOGISTE_BUDGET_DUREE_MIN et _COUT_TOKENS sont retirées (ignorées).
GENEALOGISTE_BUDGET_REQUETES_HOTE=200
GENEALOGISTE_BUDGET_IMAGES=40
# Contact facultatif ajouté au User-Agent de chaque requête externe (adresse ou URL ; jamais de valeur par défaut).
# Donnée personnelle envoyée à tous les sites interrogés : préférer une adresse dédiée. 200 caractères ASCII au
# plus, sans ( ) ; \ ni retour à la ligne ; valeur invalide ignorée (signalée par diagnostic). Sans effet si
# GENEALOGISTE_USER_AGENT est défini (envoyé tel quel). Voir docs/securite.md, identification.
#GENEALOGISTE_CONTACT=contact@example.org
# User-Agent complet imposé, remplace celui du plugin (déconseillé)
#GENEALOGISTE_USER_AGENT=
# Échec 403/404 mémorisé (s) ; pause d'un hôte après blocage anti-robot (s)
GENEALOGISTE_CACHE_ECHEC=900
GENEALOGISTE_COUPE_CIRCUIT=1800
# Exclusion (s) d'un hôte dont le défi anti-robot persiste après la pause (0 = pause seule)
GENEALOGISTE_EXCLUSION_ANTIROBOT=604800
# Intervalle maximal (s) d'un hôte ralenti pour la journée après 429/502/503/504 (×2 par incident ; 0 = jamais)
GENEALOGISTE_RALENTISSEMENT_MAX=60
# Plafonds des caches en Mo (0 = aucun) : réponses SQLite, cache-images (vues et originales)
GENEALOGISTE_CACHE_MAX_MO=500
GENEALOGISTE_CACHE_IMAGES_MAX_MO=2000
# Journal d'exploitation (outil, durée, statut, erreur nettoyée, hôtes ; jamais d'argument ni de nom)
# Niveau : DEBUG | INFO (tous les appels) | WARNING (erreurs seulement) | ERROR | AUCUN
GENEALOGISTE_LOG_NIVEAU=INFO
# Fichier rotatif (5 × 5 Mo) ; défaut <répertoire de données>/logs/serveur.log
GENEALOGISTE_LOG_FICHIER=

# Transport HTTP (Docker) : jeton exigé en « Authorization: Bearer » si défini
MCP_TOKEN=
