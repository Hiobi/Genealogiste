# Copier dans <répertoire de données>/.env (par défaut ~/.local/share/genealogiste/.env) — jamais dans un dépôt.

# Répertoire de données (dépôt Git de l'arbre) et cache
#GENEALOGISTE_DATA_DIR=~/genealogie
#GENEALOGISTE_CACHE=~/.cache/genealogiste/cache.sqlite

# WikiTree : identifiant d'application (libre, ex. « genealogiste-<pseudo> »), obligatoire
GENEALOGISTE_WIKITREE_APPID=

# matchID : jeton pour l'appariement CSV par lot (facultatif)
GENEALOGISTE_MATCHID_TOKEN=

# FamilySearch (getmyancestors) — facultatif
GENEALOGISTE_FS_USER=
GENEALOGISTE_FS_PASSWORD=

# Backend : fichier (défaut, arbre.ged GEDCOM 7 + Git) | gramps (Gramps Web = arbre de référence, voir docs/gramps-web.md)
GENEALOGISTE_BACKEND=fichier
# Gramps Web : compte LOCAL dédié à Sosa, rôle Editor
GENEALOGISTE_GRAMPS_URL=http://localhost:5055
GENEALOGISTE_GRAMPS_USER=
GENEALOGISTE_GRAMPS_PASSWORD=
# Mode gramps : miroir GEDCOM 7 versionné de l'arbre Gramps dans le dépôt des données
GENEALOGISTE_GIT_MIRROR=false
# Dépôt distant du répertoire de données (facultatif, PRIVÉ : données de vivants)
GENEALOGISTE_GIT_REMOTE=

# 1 = règle stricte 3/2/1 sources indépendantes sans pondération
GENEALOGISTE_STRICT=0
# 0 = autoriser un fait sans citation (déconseillé) ; défaut 1 : refus sauf non_source + motif
GENEALOGISTE_EXIGER_SOURCE=1
# 1 = n'utiliser que le cache
GENEALOGISTE_OFFLINE=0
