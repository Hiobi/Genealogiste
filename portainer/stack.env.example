# Variables de la stack Portainer (docker-compose.portainer.yml). Ne pas committer les valeurs réelles.

# Épingler en production (ex. v25.x) plutôt que latest
GRAMPSWEB_VERSION=latest
GRAMPSWEB_TREE=Genealogiste
# URL publique si derrière un reverse proxy (liens des e-mails)
GRAMPSWEB_BASE_URL=
# 0.0.0.0 pour exposer directement, 127.0.0.1 derrière un reverse proxy
GRAMPSWEB_BIND=127.0.0.1
GRAMPSWEB_PORT=5055

# Jeton du MCP (obligatoire) : générer avec `openssl rand -hex 32` ; clients : « Authorization: Bearer <jeton> »
MCP_TOKEN=
# Dérogation sans jeton : 1 seulement si MCP_BIND=127.0.0.1 ou derrière un proxy authentifiant
MCP_SANS_AUTH=0
MCP_BIND=127.0.0.1
MCP_PORT=8765
# Volume nommé (défaut) ou chemin absolu, ex. /srv/genealogie
GENEALOGISTE_DATA_PATH=genealogiste_data
# fichier (défaut) | gramps : travail en direct sur Gramps Web (docs/gramps-web.md)
GENEALOGISTE_BACKEND=fichier
GENEALOGISTE_GIT_MIRROR=false
GENEALOGISTE_GIT_REMOTE=

# Compte LOCAL Gramps Web dédié au MCP, rôle Editor (créé dans l'interface)
GENEALOGISTE_GRAMPS_USER=
GENEALOGISTE_GRAMPS_PASSWORD=

GENEALOGISTE_WIKITREE_APPID=
GENEALOGISTE_MATCHID_TOKEN=
GENEALOGISTE_FS_USER=
GENEALOGISTE_FS_PASSWORD=
GENEALOGISTE_STRICT=0
GENEALOGISTE_EXIGER_SOURCE=1
GENEALOGISTE_OFFLINE=0
